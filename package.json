{
  "name": "yolu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Yolu \u2014 a multi-agent development conversation tool",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nite0x/yolu.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "site:dev": "node website/serve.mjs",
    "site:build": "node website/build.mjs",
    "brand:icons": "node scripts/generate-icons.mjs",
    "web:build": "node scripts/build-frontend.mjs",
    "web:watch": "node scripts/build-frontend.mjs --watch",
    "web:check": "npm run web:architecture && npm run ui:check && tsc --noEmit",
    "web:test": "npm run web:check && npm run web:build && npm run app:test && node --test scripts/*.test.cjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "tauri build",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:check": "node --test scripts/desktop-packaging.test.mjs",
    "desktop:test": "npm run desktop:prepare && cargo test --manifest-path src-tauri/Cargo.toml",
    "chat:build": "node scripts/build-chat.mjs",
    "chat:check": "tsc -p tsconfig.chat.json",
    "chat:test": "tsx --test scripts/chat-*.test.ts",
    "app:test": "tsx --test scripts/app-*.test.ts",
    "build": "node scripts/build.mjs",
    "api:generate": "go run ./cmd/contracts",
    "api:check": "go run ./cmd/contracts --check",
    "check": "npm run api:check && npm run web:check && npm run chat:check && npm run bundle:test",
    "browser:test": "node --test scripts/browser/*.test.mjs",
    "web:architecture": "node scripts/frontend-architecture.mjs && node --test scripts/frontend-architecture.test.mjs",
    "ui:dev": "vite --config vite.ui.config.mts",
    "ui:build": "vite build --config vite.ui.config.mts",
    "ui:lint": "biome check --error-on-warnings .",
    "ui:format": "biome check --write .",
    "ui:test": "tsx --test scripts/ui-*.test.tsx",
    "ui:test:browser": "node --test scripts/ui-browser.test.mjs",
    "ui:check": "npm run ui:lint && npm run ui:test",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "bundle:test": "node --test scripts/bundle-budget.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@pierre/diffs": "^1.6.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.15.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zustand": "^5.0.16"
  }
}
